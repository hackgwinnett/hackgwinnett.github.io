{
  "name": "www",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "concurrently \"vp dev --host --port 3000\" \"content-collections watch\"",
    "build-static": "node build.ts",
    "build-server": "node build.ts --keep-server",
    "local-build": "node build.ts --ask",
    "serve-static": "vpr build-static && serve dist/client -s",
    "serve-server": "vpr build-server && serve dist/client",
    "routeTree": "tsr generate",
    "lint": "vp lint",
    "preview": "vp preview",
    "prepare": "vp config",
    "date": "node -e \"console.log(Date.now())\"",
    "sync:template": "node --no-warnings scripts/sync-newsletter-template.ts",
    "sync:env": "node --no-warnings scripts/sync-env.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^0.0.12",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.35",
    "@tanstack/start-static-server-functions": "^1.167.32",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "embla-carousel-accessibility": "9.0.0-rc02",
    "embla-carousel-autoplay": "9.0.0-rc02",
    "embla-carousel-class-names": "9.0.0-rc02",
    "embla-carousel-react": "9.0.0-rc02",
    "embla-carousel-wheel-gestures": "9.0.0-rc01",
    "motion": "^12.43.0",
    "pluralize": "^8.0.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-use-measure": "^2.1.7",
    "recharts": "3.8.1",
    "shadcn": "^4.21.0",
    "showdown": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.2",
    "@content-collections/vite": "^0.3.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.20",
    "@types/node": "^24.13.3",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/showdown": "^2.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxc-transform-react": "^0.144.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.5.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
